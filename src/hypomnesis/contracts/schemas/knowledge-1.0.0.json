{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hypomnesis/knowledge/1.0.0",
  "title": "Typed knowledge snapshot",
  "oneOf": [
    {"$ref": "#/$defs/fact"},
    {"$ref": "#/$defs/unknown"},
    {"$ref": "#/$defs/observation"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "\\S"},
    "type": {
      "type": "object",
      "required": ["name", "args"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "args": {"type": "array", "items": {"$ref": "#/$defs/type"}}
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "id"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "obs"},
            "id": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {"op": {"enum": ["zero", "one"]}}
        },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "additionalProperties": false,
          "properties": {
            "op": {"enum": ["plus", "times"]},
            "left": {"$ref": "#/$defs/provenance"},
            "right": {"$ref": "#/$defs/provenance"}
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": ["schema_version", "kind", "type", "key", "value", "provenance", "method", "premises"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"const": "fact"},
        "type": {"$ref": "#/$defs/type"},
        "key": {"$ref": "#/$defs/identifier"},
        "value": {},
        "provenance": {"$ref": "#/$defs/provenance"},
        "method": {"$ref": "#/$defs/identifier"},
        "premises": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "unknown": {
      "type": "object",
      "required": ["schema_version", "kind", "type", "key", "description"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"const": "unknown"},
        "type": {"$ref": "#/$defs/type"},
        "key": {"$ref": "#/$defs/identifier"},
        "description": {"$ref": "#/$defs/identifier"}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "origin", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["observation", "estimation", "default", "hypothesis"]},
        "origin": {"$ref": "#/$defs/identifier"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "observation": {
      "type": "object",
      "required": ["schema_version", "kind", "source", "fact"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"const": "observation"},
        "source": {"$ref": "#/$defs/source"},
        "fact": {"$ref": "#/$defs/fact"}
      }
    }
  }
}
