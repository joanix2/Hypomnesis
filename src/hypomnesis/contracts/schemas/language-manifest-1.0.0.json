{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hypomnesis/language-manifest/1.0.0",
  "title": "LanguageManifest",
  "description": "Manifest of an M2 language package: its Hypomnesis sources, contracts, adapters, and the procedure entry point (a value of type 'a Effect.t in the M1 program) with the sensors and actuators it may use. Adapter references are `file.py:attribute` inside the package.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transcriber": {
      "$ref": "#/$defs/adapter"
    },
    "examples": {
      "type": "string",
      "description": "JSON file, relative to the package, listing {request, program} pairs (optionally with a simulation environment) used to show the language in use to an LLM."
    },
    "procedure": {
      "$ref": "#/$defs/program"
    }
  },
  "required": [
    "name",
    "version",
    "sources",
    "procedure"
  ],
  "additionalProperties": false,
  "$defs": {
    "adapter": {
      "type": "string",
      "pattern": "^[^:]+\\.py:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "program": {
      "description": "The procedure is a Hypomnesis value of type 'a Effect.t, interpreted by the engine. The language declares the sensors and actuators it may use.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "program"
        },
        "entry": {
          "type": "string",
          "description": "Binding of the M1 program holding the procedure."
        },
        "environment": {
          "$ref": "#/$defs/adapter"
        },
        "sensors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "read": {
                "type": "string"
              }
            },
            "required": [
              "read"
            ],
            "additionalProperties": false
          }
        },
        "actuators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actuator": {
                "type": "string"
              },
              "adapter": {
                "$ref": "#/$defs/adapter"
              }
            },
            "required": [
              "actuator",
              "adapter"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "entry"
      ],
      "additionalProperties": false
    }
  }
}
