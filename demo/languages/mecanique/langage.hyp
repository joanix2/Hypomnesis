language mecanique = struct
  let version = "0.2.0"
  let description = "Pièces mécaniques simples : plaques, estimation d'épaisseur, contraintes d'élancement et de masse, export de géométrie, mesure ; procédures écrites en Hypomnesis."
  let sources = ["plaque.hyp"]
  let contracts = [
    "contrats/geometry.export-1.0.0.json";
    "contrats/geometry.export.result-1.0.0.json";
    "contrats/thickness.reading-1.0.0.json"
  ]
  let adapters = [
    "adaptateurs/atelier.py";
    "adaptateurs/export.py";
    "adaptateurs/transcription.py"
  ]
  let examples = "exemples.json"
  let tracing = [
    { function = "Plaque.estimer_regle"; operation = "estimator.predict" };
    { function = "Plaque.estimer_abaque"; operation = "estimator.predict" };
    { function = "Plaque.verifier"; operation = "validator.check" }
  ]
  let procedure = { kind = "program"; entry = "procedure" }
end
