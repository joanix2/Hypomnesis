language contraintes = struct
  let version = "1.0.0"
  let imports = ["../booleen"; "../arithmetique"]
  let description = "Contraintes composées à partir de couches indépendantes."
end

(** Prédicats de contraintes communs aux langages métier. *)
module Contraintes = struct
  (** Les deux grandeurs sont positives ou nulles. *)
  let positives a b =
    Booleen.conjonction (Arithmetique.positif a) (Arithmetique.positif b)
end
