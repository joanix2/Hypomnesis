language composition_b = struct
  let version = "1.0.0"
  let imports = ["../contraintes"; "../booleen"]
  let description = "Second langage composé, réutilisant les mêmes définitions."
  let procedure = { kind = "program"; entry = "procedure" }
end

(** Second langage utilisateur des couches communes. *)
module CompositionB = struct
  (** Indique si au moins une grandeur est négative. *)
  let invalide a b = Booleen.negation (Contraintes.positives a b)
end
