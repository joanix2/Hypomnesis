language booleen = struct
  let version = "1.0.0"
  let description = "Logique booléenne réutilisable, sans entrée/sortie."
end

(** Opérations booléennes communes aux langages symboliques. *)
module Booleen = struct
  (** Conjonction de deux propositions. *)
  let conjonction a b = a && b

  (** Négation d'une proposition. *)
  let negation a = not a
end
