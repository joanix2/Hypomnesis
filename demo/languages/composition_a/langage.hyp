language composition_a = struct
  let version = "1.0.0"
  let imports = ["../contraintes"; "../arithmetique"]
  let description = "Premier langage composé, avec une dépendance en diamant."
  let procedure = { kind = "program"; entry = "procedure" }
end

(** Premier langage utilisateur des couches communes. *)
module CompositionA = struct
  (** Calcule une somme lorsque les arguments sont admissibles. *)
  let calculer a b =
    if Contraintes.positives a b
    then Some (Arithmetique.addition a b)
    else None
end
