{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/hypomnesis/temperature.reading/1.0.0",
  "title": "TemperatureReading",
  "type": "object",
  "properties": {
    "sensor_id": { "type": "string", "minLength": 1 },
    "celsius": { "type": "number", "minimum": -50, "maximum": 150 }
  },
  "required": ["sensor_id", "celsius"],
  "additionalProperties": false
}
