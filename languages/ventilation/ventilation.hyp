(* Langage « ventilation » (M2) : régulation de température par ventilateur.
   Tout est en Hypomnesis : règles, et procédures dont les effets sont des valeurs
   (type 'a Effect.t) que le moteur (M3) interprète. Le langage ne fait rien
   lui-même : il décrit. *)

(** Régulation de la température d'une pièce par un ventilateur.
    @squelette
      let installation = {
        Ventilation.capteur = "thermo-1";
        ventilateur = "fan-1";
        budget = 3;
      }

      let procedure = Ventilation.reguler installation
    @note le premier champ d'un record est préfixé par le module (`Ventilation.capteur = …`),
      les autres non ; l'installation se nomme `installation` et la procédure `procedure` *)
module Ventilation = struct
  (** Une installation à réguler : un capteur, un ventilateur et un nombre maximal d'actions. *)
  type installation = {
    (** Identifiant du capteur de température.
        @exemple « le capteur thermo-1 » → "thermo-1" *)
    capteur : string;
    (** Identifiant du ventilateur à piloter.
        @exemple « le ventilateur fan-7 » → "fan-7" *)
    ventilateur : string;
    (** Nombre maximal d'actions (itérations, tentatives) de la régulation.
        @exemple « pas plus de 6 tentatives » → 6 ; « une seule action » → 1 *)
    budget : int;
  }

  (** Température au-dessus de laquelle on agit, en °C.
      @interne *)
  let seuil = 28.0                 (* °C *)
  (** Baisse de température attendue après une action, en °C.
      @interne *)
  let baisse_attendue = 1.0        (* °C après une action *)

  (* Décision : None = rien à faire ; Some v = vitesse en %. *)
  (** Vitesse de ventilation (%) pour une température (°C) : `None` si elle ne dépasse pas le
      seuil, `Some v` sinon.
      @interne *)
  let decider temperature =
    if temperature <= seuil then None
    else
      let v = 40 + int_of_float ((temperature -. seuil) *. 20.0) in
      Some (if v > 100 then 100 else v)

  (** Commande de vitesse envoyée au ventilateur.
      @interne *)
  type commande = {
    (** Identifiant du ventilateur.
        @interne *)
    fan_id : string;
    (** Vitesse demandée, en %.
        @interne *)
    speed_percent : int;
  }

  (** Vrai si la température a baissé d'au moins la baisse attendue (°C).
      @interne *)
  let effet_confirme avant apres = avant -. apres >= baisse_attendue

  (** Température en °C lue dans un relevé du capteur (0.0 si absente).
      @interne *)
  let celsius releve = Option.value (Json.num_field "celsius" releve) 0.0

  (* Procédure de régulation : observer, décider, agir, vérifier l'effet sous
     l'hypothèse explicite que le ventilateur fonctionne ; recommencer au plus
     `budget` fois. Rend la conclusion. *)
  (** Boucle de régulation, itération `i` ; étape interne de `reguler`.
      @interne *)
  let rec boucle i budget (inst : installation) cle_avant avant =
    if i > budget then Effect.return "budget épuisé"
    else
      match decider avant with
      | None ->
        Effect.note (Float.to_string avant ^ " °C : sous le seuil, aucune action") >>= fun () ->
        Effect.return "aucune action nécessaire"
      | Some vitesse ->
        let n = string_of_int i in
        Effect.record ("decision." ^ n) vitesse "Ventilation.decider" (Effect.Derived [cle_avant]) >>= fun () ->
        Effect.record ("effet_attendu." ^ n) true "baisse attendue si le ventilateur fonctionne"
          (Effect.Derived ["decision." ^ n; "hypothese"]) >>= fun () ->
        Effect.act "fan.set" { fan_id = inst.ventilateur; speed_percent = vitesse } >>= fun _ ->
        Effect.observe inst.capteur >>= fun (cle_apres, releve) ->
        let apres = celsius releve in
        if effet_confirme avant apres then
          Effect.record ("effet_confirme." ^ n) true "Ventilation.effet_confirme"
            (Effect.Derived [cle_avant; cle_apres]) >>= fun () ->
          Effect.note (Float.to_string avant ^ " → " ^ string_of_int vitesse ^ " % → "
                       ^ Float.to_string apres ^ " °C : effet confirmé") >>= fun () ->
          boucle (i + 1) budget inst cle_apres apres
        else
          Effect.retract "hypothese" "effet attendu non observé" >>= fun invalides ->
          Effect.record "hypothese.refutee" true "commande exécutée mais température non abaissée"
            (Effect.Derived ["decision." ^ n; cle_avant; cle_apres]) >>= fun () ->
          Effect.note (Float.to_string avant ^ " → " ^ string_of_int vitesse ^ " % → "
                       ^ Float.to_string apres ^ " °C : effet réfuté ; invalidés : "
                       ^ String.concat ", " invalides) >>= fun () ->
          Effect.return "hypothèse réfutée : le ventilateur ne fonctionne pas (alerte)"

  (** Régule la température : observe le capteur, règle la vitesse du ventilateur si la
      température dépasse le seuil, vérifie l'effet, recommence au plus `budget` fois.
      @quand « régule », « surveille », « pilote », « maintiens la température »
      @exemple « régule avec thermo-1 et fan-7, 6 tentatives max » →
        Ventilation.reguler installation *)
  let reguler (inst : installation) =
    Effect.record "hypothese" true "le ventilateur fonctionne" (Effect.Assumed 0.9) >>= fun () ->
    Effect.observe inst.capteur >>= fun (cle, releve) ->
    boucle 1 inst.budget inst cle (celsius releve)
end
