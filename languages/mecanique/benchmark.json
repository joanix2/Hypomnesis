      "expect": { "bindings": { "demande": { "largeur": 90.0, "hauteur": 140.0, "epaisseur": null, "masse_max": 0.45 } } }
    },
    {
      "id": "t12-nom", "split": "test",
      "request": "Plaque couvercle de 38 cm sur 26 cm, limitée à 2,8 kg.",
      "expect": { "bindings": { "demande": { "nom": "couvercle", "largeur": 380.0, "hauteur": 260.0, "epaisseur": null, "masse_max": 2.8 } } }
    },
    {
      "id": "t13-minimal", "split": "test",
      "request": "plaque 100x100 3mm",
      "expect": { "bindings": { "demande": { "largeur": 100.0, "hauteur": 100.0, "epaisseur": 3.0, "masse_max": "*" } } }
    },
    {
      "id": "t14-metres-decimaux", "split": "test",
      "request": "Génère une plaque de 0,18 m × 0,12 m, au plus 900 g, épaisseur 2 mm.",
