    },
    {
      "id": "t15-mesure-ensuite", "split": "test",
      "request": "Une plaque de 65 × 45 mm dont la masse ne doit pas dépasser 0,08 kg ; ensuite, mesure-la au pied à coulisse.",
      "expect": { "bindings": { "demande": { "largeur": 65.0, "hauteur": 45.0, "epaisseur": null, "masse_max": 0.08 } }, "calls": ["Plaque.concevoir_puis_mesurer"] },
      "environment": { "mesure": "2" }
    },
    {
      "id": "t16-calcule", "split": "test",
      "request": "Calcule l'épaisseur d'une plaque de 500 × 350 mm, maximum 7,5 kg.",
      "expect": { "bindings": { "demande": { "largeur": 500.0, "hauteur": 350.0, "epaisseur": null, "masse_max": 7.5 } }, "not_calls": ["concevoir_puis_mesurer"] }
    },
    {
      "id": "h01-nombres-en-lettres", "split": "hard",
      "request": "Plaque de trente centimètres sur vingt, pas plus de deux kilos.",
      "expect": { "bindings": { "demande": { "largeur": 300.0, "hauteur": 200.0, "epaisseur": null, "masse_max": 2.0 } } }
    },
    {
      "id": "h02-ordre-inverse", "split": "hard",
      "request": "Plaque haute de 12 cm et large de 30 cm, 1 kg max.",
      "expect": { "bindings": { "demande": { "largeur": 300.0, "hauteur": 120.0, "epaisseur": null, "masse_max": 1.0 } } }
    },
    {
      "id": "h03-unites-mixtes", "split": "hard",
      "request": "Plaque de 1 m × 250 mm, masse maximale 8 kg.",
      "expect": { "bindings": { "demande": { "largeur": 1000.0, "hauteur": 250.0, "epaisseur": null, "masse_max": 8.0 } } }
    },
    {
      "id": "h04-epaisseur-decimale", "split": "hard",
      "request": "Plaque de 100 × 100 mm, épaisseur 1,2 mm, tolérance de masse : 150 grammes.",
      "expect": { "bindings": { "demande": { "largeur": 100.0, "hauteur": 100.0, "epaisseur": 1.2, "masse_max": 0.15 } } }
    },
    {
      "id": "h05-abaque-puis-mesure", "split": "hard",
      "request": "Je cherche une plaque 18x12 cm : estime d'abord l'épaisseur à l'abaque, puis mesure-la, 2 kg max.",
      "expect": { "bindings": { "demande": { "largeur": 180.0, "hauteur": 120.0, "epaisseur": null, "masse_max": 2.0 } }, "calls": ["Plaque.concevoir_puis_mesurer", "Plaque.estimateur_abaque"] },
      "environment": { "mesure": "4" }
    },
    {
      "id": "h06-negation-mesure", "split": "hard",
      "request": "Plaque de 80 mm sur 60 mm, 0,25 kg maximum. Ne la mesure pas, je veux seulement la dimensionner.",
      "expect": { "bindings": { "demande": { "largeur": 80.0, "hauteur": 60.0, "epaisseur": null, "masse_max": 0.25 } }, "not_calls": ["concevoir_puis_mesurer"] }
    },
    {
      "id": "h07-sans-limite", "split": "hard",
      "request": "Pas de limite de poids. Plaque 90 × 70 mm, épaisseur à déterminer.",
      "expect": { "bindings": { "demande": { "largeur": 90.0, "hauteur": 70.0, "epaisseur": null, "masse_max": 1000.0 } } }
    },
    {
