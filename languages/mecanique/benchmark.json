    },
    {
      "id": "h13-epaisseur-sans-unite", "split": "hard",
      "request": "plaque 250x150 mm, ep 4, 1.2kg",
      "expect": { "bindings": { "demande": { "largeur": 250.0, "hauteur": 150.0, "epaisseur": 4.0, "masse_max": 1.2 } } }
    },
    {
      "id": "h14-sous-entendu-cm", "split": "hard",
