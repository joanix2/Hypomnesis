{
  "name": "mecanique",
  "version": "0.2.0",
  "description": "Pièces mécaniques simples : plaques, estimation d'épaisseur, contraintes d'élancement et de masse, export de géométrie, mesure ; procédures écrites en Hypomnesis.",
  "sources": ["plaque.hyp"],
  "contracts": [
    "contrats/geometry.export-1.0.0.json",
    "contrats/geometry.export.result-1.0.0.json",
    "contrats/thickness.reading-1.0.0.json"
  ],
  "transcriber": "adaptateurs/transcription.py:transcrire",
  "procedure": {
    "kind": "program",
    "entry": "procedure",
    "environment": "adaptateurs/atelier.py:atelier",
    "sensors": { "pied-a-coulisse": { "read": "message" } },
    "actuators": [{ "actuator": "geometry.export", "adapter": "adaptateurs/export.py:actionneur" }]
  }
}
