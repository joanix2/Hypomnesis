{
  "name": "Hypomnesis",
  "scopeName": "source.hypomnesis",
  "patterns": [
    {"include": "#documentation"},
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#language-declaration"},
    {"include": "#file-import"},
    {"include": "#type-declaration"},
    {"include": "#keywords"},
    {"include": "#numbers"},
    {"name": "storage.type.hypomnesis", "match": "\\b(?:int|float|string|bool|unit|list|option)\\b"},
    {"include": "#type-variable"},
    {"name": "entity.name.type.hypomnesis", "match": "\\b[A-Z][A-Za-z0-9_']*\\b"},
    {"name": "keyword.operator.hypomnesis", "match": ">>=|\\|>|@@|->|::|\\|\\||&&|<>|<=|>=|\\*\\*|[+*/-]\\.|[=<>@^+*/|:-]"},
    {"name": "punctuation.section.hypomnesis", "match": "[()\\[\\]{};,\\.]"}
  ],
  "repository": {
    "file-import": {
      "match": "\\b(import|from)[ \\t]+([a-z_][A-Za-z0-9_']*(?:\\.[a-z_][A-Za-z0-9_']*)*)",
      "captures": {
        "1": {"name": "keyword.control.hypomnesis"},
        "2": {"name": "entity.name.namespace.hypomnesis"}
      }
    },
    "language-declaration": {
      "name": "meta.language.hypomnesis",
      "begin": "\\b(language)\\s+([a-z_][A-Za-z0-9_']*)",
      "beginCaptures": {
        "1": {"name": "keyword.control.hypomnesis"},
        "2": {"name": "entity.name.type.language.hypomnesis"}
      },
      "end": "(?<=\\bend\\b)|(?=\\{)",
      "patterns": [
        {"include": "#documentation"},
        {"include": "#comment"},
        {"include": "#language-body"},
        {"name": "keyword.operator.hypomnesis", "match": "="}
      ]
    },
    "language-body": {
      "name": "meta.body.language.hypomnesis",
      "begin": "\\bstruct\\b",
      "beginCaptures": {"0": {"name": "keyword.control.hypomnesis"}},
      "end": "\\bend\\b",
      "endCaptures": {"0": {"name": "keyword.control.hypomnesis"}},
      "patterns": [
        {"include": "#documentation"},
        {"include": "#comment"},
        {"include": "#string"},
        {"include": "#language-record"},
        {
          "match": "\\b(let)\\s+([a-z_][A-Za-z0-9_']*)\\s*(=)",
          "captures": {
            "1": {"name": "keyword.control.hypomnesis"},
            "2": {"name": "variable.other.property.hypomnesis"},
            "3": {"name": "keyword.operator.hypomnesis"}
          }
        },
        {"include": "#keywords"},
        {"include": "#numbers"},
        {"name": "punctuation.section.hypomnesis", "match": "[\\[\\];,]"}
      ]
    },
    "language-record": {
      "name": "meta.record.language.hypomnesis",
      "begin": "\\{",
      "beginCaptures": {"0": {"name": "punctuation.section.hypomnesis"}},
      "end": "\\}",
      "endCaptures": {"0": {"name": "punctuation.section.hypomnesis"}},
      "patterns": [
        {"include": "#documentation"},
        {"include": "#comment"},
        {"include": "#string"},
        {"include": "#language-record"},
        {
          "match": "\\b([a-z_][A-Za-z0-9_']*)\\s*(=)",
          "captures": {
            "1": {"name": "variable.other.property.hypomnesis"},
            "2": {"name": "keyword.operator.hypomnesis"}
          }
        },
        {"include": "#keywords"},
        {"include": "#numbers"},
        {"name": "keyword.operator.hypomnesis", "match": "-"},
        {"name": "punctuation.section.hypomnesis", "match": "[\\[\\];,]"}
      ]
    },
    "type-declaration": {
      "match": "\\b(type)\\s+(?:('[a-z_][A-Za-z0-9_']*|\\([^)]*\\))\\s+)?([a-z_][A-Za-z0-9_']*)",
      "captures": {
        "1": {"name": "keyword.control.hypomnesis"},
        "2": {"patterns": [{"include": "#type-variable"}]},
        "3": {"name": "entity.name.type.hypomnesis"}
      }
    },
    "type-variable": {
      "name": "entity.name.type.variable.hypomnesis",
      "match": "'[a-z_][A-Za-z0-9_']*"
    },
    "documentation": {
      "name": "comment.block.documentation.hypomnesis",
      "begin": "\\(\\*\\*(?!\\))",
      "end": "\\*\\)",
      "patterns": [
        {"include": "#comment"},
        {"name": "storage.type.annotation.hypomnesis", "match": "@[a-z][a-z-]*"}
      ]
    },
    "comment": {
      "name": "comment.block.hypomnesis",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [{"include": "#comment"}]
    },
    "string": {
      "name": "string.quoted.double.hypomnesis",
      "begin": "\"",
      "end": "\"",
      "patterns": [{"name": "constant.character.escape.hypomnesis", "match": "\\\\."}]
    },
    "keywords": {
      "name": "keyword.control.hypomnesis",
      "match": "\\b(?:and|as|else|end|external|false|from|fun|function|if|import|in|language|let|match|mod|module|of|open|rec|struct|then|true|type|when|with)\\b"
    },
    "numbers": {
      "name": "constant.numeric.hypomnesis",
      "match": "\\b\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?(?![A-Za-z_'])"
    }
  }
}
